# ---- Application ----
APP_ENV=development
PORT=8080

# ---- Database (MySQL) ----
# NOTE: The assignment's sample env block shows Postgres values, but Section 2
# mandates MySQL as the stack. This project uses MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=todo_db

# ---- Auth (JWT) ----
# Use a long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=24h

# ---- Rate limiting ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1m

# ---- Logging ----
# one of: debug, info, warn, error
LOG_LEVEL=info

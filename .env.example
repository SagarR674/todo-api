# ---- Application ----
APP_ENV=development
PORT=8080

# ---- Database (MySQL) ----
# NOTE: The assignment's sample env block shows Postgres values, but Section 2
# mandates MySQL as the stack. This project uses MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=todo_db

# Run pending migrations automatically on startup (handy for Docker / first run).
AUTO_MIGRATE=false

# ---- Auth (JWT) ----
# Use a long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=24h

# ---- CORS ----
# Comma-separated allowed origins for browser clients. "*" allows any origin
# (fine for local development). Set specific origins in production.
CORS_ORIGINS=*

# ---- Rate limiting ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1m

# ---- Logging ----
# one of: debug, info, warn, error
LOG_LEVEL=info

# ---- Integration tests ----
# The integration test suite (go test ./test/...) needs its own MySQL schema so
# it can freely create and drop tables. It falls back to the DB_* values above
# with "_test" appended to the name. Override here if needed:
# TEST_DB_HOST=localhost
# TEST_DB_PORT=3306
# TEST_DB_USER=root
# TEST_DB_PASSWORD=your-mysql-password
# TEST_DB_NAME=todo_db_test
